# Reference only: inject these variables through SSM/secrets in production.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/villa_serena
SPRING_DATASOURCE_USERNAME=villa_serena
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
WEB_URL=https://hotel.example
CORS_ORIGENES=https://hotel.example
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Configure when enabling the corresponding feature.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=Hotel Villa Serena <no-responder@hotel.example>
# Native S3 endpoint resolution; EC2 instance role provides temporary credentials.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PRIVATE=REPLACE_WITH_TERRAFORM_PRIVATE_BUCKET
STORAGE_PATH_STYLE=false
ARCHIVOS_URL_PUBLICA=https://REPLACE_WITH_CLOUDFRONT_DOMAIN
APP_DOWNLOAD_URL=https://REPLACE_WITH_CLOUDFRONT_DOMAIN/app/villaserena.apk
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
