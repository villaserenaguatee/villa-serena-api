# Variables de entorno del API. Copia este archivo como .env (está en
# .gitignore) y pon tus propios valores. Nunca subas el .env a Git.

# --- Datos iniciales de Flyway (V6__datos_iniciales.sql) ---------------

# Hash BCrypt de la contraseña de demostración de TODOS los empleados de
# prueba. Elige tu contraseña y genera el hash, por ejemplo con:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'TuContraseñaDemo1' | tr -d ':\n'
# Pégalo sin comillas (Spring lee este archivo como .properties).
DEMO_PASSWORD_HASH=<HASH_BCRYPT_DE_TU_CONTRASENA>

# Hash SHA-256 (hexadecimal, 64 caracteres en minúsculas) de la clave de
# cada canal simulado. Elige una clave para cada canal y genera su hash:
#   printf '%s' '<CLAVE_DEL_CANAL>' | sha256sum | cut -d' ' -f1
# La clave en texto plano va solo en el .env del canal simulado (web).
CANAL1_KEY_HASH=<SHA256_DE_LA_CLAVE_DE_BOOKING>
CANAL2_KEY_HASH=<SHA256_DE_LA_CLAVE_DE_EXPEDIA>

# --- Base de datos local (villa-serena-infra) ---------------------------
DB_URL=jdbc:postgresql://localhost:5432/villaserena
DB_USER=villaserena
# La misma POSTGRES_PASSWORD del .env de villa-serena-infra.
DB_PASSWORD=<TU_CONTRASENA_POSTGRES>

# --- Seguridad (OBJ-0D) -------------------------------------------------
# Clave de firma de los JWT, en Base64 (al menos 32 bytes). Genérala con:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=<CLAVE_BASE64_DE_AL_MENOS_32_BYTES>

# Primer Administrador (opcional): se crea al arrancar si su correo no
# existe, con contraseña temporal. Si falta alguna, no se crea.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Orígenes permitidos por CORS (la web/BFF).
CORS_ORIGENES=http://localhost:3000

# --- Reservas y Stripe (OBJ-1B) -----------------------------------------
# Claves de Stripe en MODO PRUEBA (empiezan con sk_test_ y whsec_). La de
# webhook la imprime `stripe listen` (ver la guía de Stripe CLI).
STRIPE_SECRET_KEY=<TU_sk_test_DE_STRIPE>
STRIPE_WEBHOOK_SECRET=<TU_whsec_DE_STRIPE_CLI>
# Página de la web a la que vuelve Stripe (/reserva/resultado?codigo=...).
WEB_URL=http://localhost:3000
# Minutos para pagar una reserva web antes de cancelarla (30). Para probar
# la cancelación automática puedes bajarlo, por ejemplo a 2.
MINUTOS_PAGO=30
# URL del bucket público de MinIO (fotos de los tipos de habitación).
ARCHIVOS_URL_PUBLICA=http://localhost:9000/villaserena-publico
