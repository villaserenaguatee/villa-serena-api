# cp .env.dev.example .env.dev; fill secrets, without quotes or shell expansions.
DB_PASSWORD=
JWT_SECRET=
# Optional first admin: enable only for the initial setup, then disable.
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Defaults: DB_USER/DB_NAME=villaserena, API_PORT=8080, POSTGRES_PORT=5432.
WEB_URL=http://localhost:3000
CORS_ORIGENES=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Remote Cloudflare R2. Create scoped S3 access keys after applying infra.
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_PRIVATE=villa-serena-dev-private
STORAGE_PATH_STYLE=true
ARCHIVOS_URL_PUBLICA=https://assets-dev.villaserenaguate.lat
APP_DOWNLOAD_URL=https://assets-dev.villaserenaguate.lat/app/villaserena.apk
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Optional payment tests: Sandbox credentials, never production credentials.
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
