# cp .env.dev.example .env.dev; fill secrets, without quotes or shell expansions.
DB_PASSWORD=
JWT_SECRET=
# Optional first admin: enable only for the initial setup, then disable.
BOOTSTRAP_ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# Defaults: DB_USER/DB_NAME=villaserena, API_PORT=8080, POSTGRES_PORT=5432.
WEB_URL=http://localhost:3000
CORS_ORIGENES=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

MINIO_ROOT_USER=villaserena
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_PUBLIC=villaserena-publico
MINIO_BUCKET_PRIVATE=villaserena-privado
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
ARCHIVOS_URL_PUBLICA=http://localhost:9000/villaserena-publico
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Optional payment tests: Sandbox credentials, never production credentials.
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
